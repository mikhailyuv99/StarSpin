# Supabase — either naming style works
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SECRET_KEY=your-secret-service-role-key

# Legacy aliases (optional)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing (34€/mo · 340€/yr recurring)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_1ToRrQLdigJa0nWpx8uevojZ
STRIPE_PRICE_ANNUAL=price_1ToRssLdigJa0nWpw83MJwLW
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# App URL (QR codes, auth redirects, Stripe — official domain)
NEXT_PUBLIC_APP_URL=https://starspin.cc

# Resend (prize claim emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=STARSPIN <noreply@starspin.cc>

# Twilio SMS (OTP) — optional in dev (code logged to console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Places API (cron review counts)
GOOGLE_PLACES_API_KEY=

# Cron job auth
CRON_SECRET=generate-a-random-secret

# Legacy global fallback (unused — per-merchant setting in dashboard → Prizes)
# SPIN_COOLDOWN_DAYS=0
