# Supabase — either naming style works
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SECRET_KEY=your-secret-service-role-key

# Legacy aliases (optional)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# App URL (used for QR codes and auth redirects)
NEXT_PUBLIC_APP_URL=https://your-app.netlify.app

# Twilio SMS (OTP) — optional in dev (code logged to console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Places API (cron review counts)
GOOGLE_PLACES_API_KEY=

# Cron job auth
CRON_SECRET=generate-a-random-secret

# Anti-abus: jours entre 2 spins (0 = désactivé pour tests, 30 en prod)
SPIN_COOLDOWN_DAYS=0
